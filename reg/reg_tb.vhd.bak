library ieee;
use ieee.std_logic_1164.all;

entity tb_reg is
end tb_reg;

architecture test of tb_reg is
    component reg
        port (
            clk   : in std_logic;
            clear : in std_logic;
            load  : in std_logic;
            d     : in std_logic_vector(3 downto 0);
            q     : out std_logic_vector(3 downto 0)
        );
    end component;

    signal clk_tb   : std_logic := '0';
    signal clear_tb : std_logic := '0';
    signal load_tb  : std_logic := '0';
    signal d_tb     : std_logic_vector(3 downto 0) := "0000";
    signal q_tb     : std_logic_vector(3 downto 0);

    constant clk_period : time := 10 ns;

begin
    dut: reg port map (
        clk   => clk_tb,
        clear => clear_tb,
        load  => load_tb,
        d     => d_tb,
        q     => q_tb
    );

    -- Generador de reloj
    clk_process: process
    begin
        clk_tb <= '0';
        wait for clk_period/2;
        clk_tb <= '1';
        wait for clk_period/2;
    end process;

    -- Estímulos
    stim_proc: process
    begin
        -- Test 1: Clear asíncrono (debería funcionar inmediatamente)
        report "Test 1: Clear asíncrono";
        clear_tb <= '1';
        wait for 5 ns;  -- ¡No esperar flanco de reloj!

        assert q_tb = "0000"
            report "Error: Clear asíncrono no funciona"
            severity error;

        -- Test 2: Desactivar clear y cargar dato
        report "Test 2: Cargar dato después de clear";
        clear_tb <= '0';
        d_tb <= "0101";
        load_tb <= '1';
        wait for 15 ns;  -- Esperar flanco de reloj

        assert q_tb = "0101"
            report "Error: No cargó el dato"
            severity error;

        -- Test 3: Clear durante operación normal
        report "Test 3: Clear mientras hay dato";
        d_tb <= "1111";
        wait for 3 ns;  -- En medio del ciclo

        clear_tb <= '1';  -- ¡Debería borrar inmediatamente!
        wait for 2 ns;

        assert q_tb = "0000"
            report "Error: Clear no sobrescribió durante ciclo"
            severity error;

        -- Test 4: Load sin clear
        report "Test 4: Carga normal";
        clear_tb <= '0';
        d_tb <= "1100";
        wait for 10 ns;  -- Próximo flanco

        assert q_tb = "1100"
            report "Error: Carga falló después de clear"
            severity error;

        report "Simulación completada";
        wait;
    end process;

end test;