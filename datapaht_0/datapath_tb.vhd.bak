library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_unsigned.all;
use ieee.numeric_std.all;

entity datapath_tb is
end datapath_tb;

architecture testbench of datapath_tb is
    component datapath
        port (
            clk : in std_logic;
            input : in std_logic_vector(3 downto 0);
            ie : in std_logic;
            alu_ctrl : in std_logic_vector(2 downto 0);
            load : in std_logic;
            clear : in std_logic;
            oe : in std_logic;
            output : out std_logic_vector(3 downto 0)
        );
    end component;
    
    -- Señales de prueba
    signal clk : std_logic := '0';
    signal input : std_logic_vector(3 downto 0);
    signal ie, load, clear, oe : std_logic;
    signal alu_ctrl : std_logic_vector(2 downto 0);
    signal output : std_logic_vector(3 downto 0);
    
    constant CLK_PERIOD : time := 10 ns;
    
begin
    uut: datapath
        port map (
            clk => clk,
            input => input,
            ie => ie,
            alu_ctrl => alu_ctrl,
            load => load,
            clear => clear,
            oe => oe,
            output => output
        );
    
    clk_process: process
    begin
        clk <= '0';
        wait for CLK_PERIOD/2;
        clk <= '1';
        wait for CLK_PERIOD/2;
    end process;
    
    -- Test 1: Generar secuencia 1,2,3,...,10 usando INCREMENTO
    stim_proc: process
    begin
        report "=== TEST 1: Generar secuencia 1..10 ===";
        
        -- Inicializar
        input <= "0000";
        ie <= '0';          -- Usar constante '1111' (no importa para incremento)
        alu_ctrl <= "000";  -- Temporal
        load <= '0';
        clear <= '0';
        oe <= '0';
        wait for CLK_PERIOD;
        
        -- 1. CLEAR registro
        clear <= '1';
        wait for CLK_PERIOD;
        clear <= '0';
        wait for CLK_PERIOD;
        
        -- 2. Cargar valor inicial 1 usando identidad
        input <= "0001";
        ie <= '1';          -- Usar input externo
        alu_ctrl <= "000";  -- Identidad (pasa input)
        load <= '1';
        wait for CLK_PERIOD;
        
        -- Mostrar 1
        load <= '0';
        oe <= '1';
        wait for CLK_PERIOD;
        report "Valor 1: " & integer'image(to_integer(unsigned(output)));
        oe <= '0';
        wait for CLK_PERIOD;
        
        -- 3. Generar 2..10 usando INCREMENTO con IE=0
        for i in 2 to 10 loop
            ie <= '0';          -- Selecciona '1111' (no se usa en incremento)
            alu_ctrl <= "011";  -- INCREMENTO (a + 1)
            load <= '1';
            wait for CLK_PERIOD;
            
            -- Mostrar
            load <= '0';
            oe <= '1';
            wait for CLK_PERIOD;
            report "Valor " & integer'image(i) & ": " & 
                   integer'image(to_integer(unsigned(output)));
            oe <= '0';
            wait for CLK_PERIOD;
        end loop;
        
        wait for 2*CLK_PERIOD;
        
        -- Test 2: Sumatoria 1+2+3+...+10 usando SUMA
        report "=== TEST 2: Sumatoria 1+2+3+...+10 ===";
        
        -- 1. CLEAR registro (acumulador = 0)
        clear <= '1';
        wait for CLK_PERIOD;
        clear <= '0';
        wait for CLK_PERIOD;
        
        -- Mostrar 0
        oe <= '1';
        wait for CLK_PERIOD;
        report "Acumulador inicial: " & integer'image(to_integer(unsigned(output)));
        oe <= '0';
        wait for CLK_PERIOD;
        
        -- Sumar números 1 al 10
        for i in 1 to 10 loop
            -- Configurar número a sumar
            input <= std_logic_vector(to_unsigned(i, 4));
            ie <= '1';          -- Usar input
            alu_ctrl <= "001";  -- SUMA (a + b)
            load <= '1';
            wait for CLK_PERIOD;
            
            -- Mostrar acumulado parcial
            load <= '0';
            oe <= '1';
            wait for CLK_PERIOD;
            report "Suma parcial (" & integer'image(i) & "): " & 
                   integer'image(to_integer(unsigned(output)));
            oe <= '0';
            wait for CLK_PERIOD;
        end loop;
        
        -- Resultado final (55 mod 16 = 7 porque es de 4 bits)
        oe <= '1';
        wait for 2*CLK_PERIOD;
        report "Resultado final (55 mod 16): " & integer'image(to_integer(unsigned(output)));
        
        wait;
    end process;
    
end testbench;